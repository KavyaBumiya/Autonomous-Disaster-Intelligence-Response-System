# Copy to .env.local (dev) or set in Vercel Project → Settings → Environment Variables.
# Vite only reads VITE_* vars at build time — redeploy after changing them on Vercel.

# Mapbox (browser)
VITE_MAPBOX_TOKEN=

# Backend origin — required on Vercel (no local proxy).
# Examples:
#   VITE_API_BASE_URL=https://your-api.onrender.com
#   VITE_WS_URL=https://your-api.onrender.com
# Local docker (dev only): leave unset or use http://localhost:8000
VITE_API_BASE_URL=
VITE_WS_URL=

# AEGISAI console — frontend environment
#
# Copy to `.env.local` for local development. Every variable is optional; the
# console falls back to the original demo dataset whenever the backend is
# unreachable, so you can run the UI standalone.

# Absolute origin of the AEGISAI backend, including scheme, no trailing slash.
# Leave EMPTY to use the same origin as the page — that is what you want behind
# the Vite dev proxy locally, and behind a reverse proxy in production.
# Example: https://aegis-api.example.com
VITE_API_BASE_URL=

# Absolute origin for the Socket.IO connection. Leave empty to reuse
# VITE_API_BASE_URL. Include the scheme and port but no trailing slash.
VITE_SOCKET_URL=

# Where the Vite dev server forwards /api and /socket.io when
# VITE_API_BASE_URL is empty. Dev-only; ignored in production builds.
VITE_DEV_PROXY_TARGET=http://localhost:8000

# How often each panel re-reads the backend, in milliseconds. Socket.IO
# pushes trigger an early refresh, but polling remains the source of truth.
VITE_POLL_INTERVAL_MS=15000

# Client-side timeouts, in milliseconds. The assistant/query timeout is longer
# because it may invoke several tools before answering.
VITE_REQUEST_TIMEOUT_MS=20000
VITE_COMMAND_TIMEOUT_MS=90000

# Pin the console to one zone. Leave empty to resolve the primary zone from
# GET /api/zones using the highest zone priority.
VITE_ZONE_ID=

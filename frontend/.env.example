# Copy to .env.local (dev) or set in Vercel Project → Settings → Environment Variables.
# Vite only reads VITE_* vars at build time — redeploy after changing them on Vercel.

# Mapbox public token (browser-visible by design; restrict URL in Mapbox dashboard)
VITE_MAPBOX_TOKEN=

# Cesium ion token (https://ion.cesium.com) — optional. Unlocks ion satellite
# imagery + world terrain on the 3D globe; without it the globe uses
# OpenStreetMap imagery and ellipsoid terrain.
VITE_CESIUM_ION_TOKEN=

# Backend origin — required on Vercel (no local proxy).
VITE_API_BASE_URL=https://autonomous-disaster-intelligence.onrender.com
VITE_WS_URL=https://autonomous-disaster-intelligence.onrender.com

# Local docker (dev only): leave VITE_API_BASE_URL unset or use http://localhost:8000
# Never put GROQ_API_KEY, DATABASE_URL, or other server secrets in VITE_* vars.

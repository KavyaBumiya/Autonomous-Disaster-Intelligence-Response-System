  ╔══════════════════════════════════════════════════════════════════════╗
# ║  AegisAI — Environment Configuration                                ║
# ║  Copy this to .env and fill in real values before starting.         ║
# ║  NEVER commit your .env file to version control.                    ║
# ╚══════════════════════════════════════════════════════════════════════╝

# ── Database ────────────────────────────────────────────────────────────
POSTGRES_DB=aegisai
POSTGRES_USER=aegisai
POSTGRES_PASSWORD=change_me_in_production
DATABASE_URL=postgresql+asyncpg://aegisai:change_me_in_production@localhost:5432/aegisai

# ── Redis ───────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── NVIDIA NIM AI Gateway ───────────────────────────────────────────────
# Get your key at https://build.nvidia.com (NVIDIA API Catalog → Get API Key).
# SECURITY: This key MUST remain on the backend only. Never expose to browser.
# NEVER paste the real key into this file, git, chat, or tickets.
# The endpoint is OpenAI-compatible, so any OpenAI-style client also works.
NVIDIA_API_KEY=

# NIM chat-completions base URL (OpenAI-compatible).
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Chat / parse / summarise / explain / translate model (namespaced model id).
# List what your key can actually reach:
#   curl https://integrate.api.nvidia.com/v1/models -H "Authorization: Bearer $NVIDIA_API_KEY"
NVIDIA_MODEL=deepseek-ai/deepseek-v4.1-flash

# Optional alternate model, used only when the primary errors. Leave blank
# unless you have verified another model id against your key.
NVIDIA_FALLBACK_MODEL=
NVIDIA_TIMEOUT_SECONDS=60
# Safety cap on the agentic tool-calling loop (rounds of tool execution).
NVIDIA_MAX_TOOL_ROUNDS=5

# ── External APIs (connector base URLs — §35) ───────────────────────────
# All optional: defaults in app/core/config.py match these values.
USGS_API_BASE=https://earthquake.usgs.gov/fdsnws/event/1
USGS_FEED_URL=https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/all_hour.geojson
OPEN_METEO_API_BASE=https://api.open-meteo.com/v1
OPEN_METEO_ARCHIVE_BASE=https://archive-api.open-meteo.com/v1/era5
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
OSRM_API_BASE=https://router.project-osrm.org
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
RELIEFWEB_API_URL=https://api.reliefweb.int/v1/
TWITTER_BEARER_TOKEN=your_twitter_bearer_token_here
MAPBOX_ACCESS_TOKEN=your_mapbox_token_here
NOMINATIM_USER_AGENT=AegisAI/1.0
# Satellite (§3): provider credentials go here ONLY when the actual provider
# is known — never invent names/values. Keep server-side, never in Vercel.

# ── Auth ────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change_this_to_a_long_random_string_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ── Social media polling ────────────────────────────────────────────────
SOCIAL_HASHTAGS=#flood,#earthquake,#cyclone,#fire,#disaster,#SOS,#rescue
SOCIAL_POLL_INTERVAL_SECONDS=60
SOCIAL_PROVIDER=twitter

# ── Speech-to-text ──────────────────────────────────────────────────────
# Provider: local (openai-whisper) | disabled (reject voice reports outright).
# NIM's chat-completions endpoint serves text models only — no cloud STT.
STT_PROVIDER=local
WHISPER_MODEL=base
WHISPER_MAX_DURATION_SECONDS=30

# ── NLP ─────────────────────────────────────────────────────────────────
NLP_MODEL_PATH=nlp/v1
NLP_MODEL_VERSION=v1_distilbert

# ── App ──────────────────────────────────────────────────────────────────
APP_ENV=development

# Browser origin allowed by CORS (comma-separated). Empty = allow all (local demo).
# The operator UI is built and hosted separately; set this to its origin.
# Example: FRONTEND_ORIGIN=https://your-frontend.onrender.com
FRONTEND_ORIGIN=

# ── Demo ────────────────────────────────────────────────────────────────
DEMO_SCENARIO=vadodara_flood

# -- NASA (server-side only; never expose to browser/Vercel) ---------------
# api.nasa.gov developer key (default 1,000 req/h). Get one at https://api.nasa.gov
# SECURITY: real key goes in .env only � never commit it, never send to Vercel.
# NOTE: applies to api.nasa.gov services. EONET is open/keyless; Earthdata/CMR
# is a separate credential ecosystem (do not reuse this key there).
NASA_API_KEY=
NASA_API_BASE=https://api.nasa.gov
EONET_BASE_URL=https://eonet.gsfc.nasa.gov/api/v3
EONET_POLL_INTERVAL_MINUTES=10

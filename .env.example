  # ╔══════════════════════════════════════════════════════════════════════╗
# ║  AegisAI — Environment Configuration                                ║
# ║  Copy this to .env and fill in real values before starting.         ║
# ║  NEVER commit your .env file to version control.                    ║
# ╚══════════════════════════════════════════════════════════════════════╝

# ── Database ────────────────────────────────────────────────────────────
POSTGRES_DB=aegisai
POSTGRES_USER=aegisai
POSTGRES_PASSWORD=change_me_in_production
DATABASE_URL=postgresql+asyncpg://aegisai:change_me_in_production@localhost:5432/aegisai

# ── Redis ───────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Groq AI Gateway ─────────────────────────────────────────────────────
# Get your key at https://console.groq.com
# SECURITY: This key MUST remain on the backend only. Never expose to browser.
# NEVER paste the real key into this file, git, chat, or tickets.
GROQ_API_KEY=

# Chat / parse / summarise model (must be available on your key tier).
# Check available models:
#   python -c "from groq import Groq; c=Groq(api_key='KEY'); [print(m.id) for m in c.models.list().data]"
# Confirmed on this tier: qwen/qwen3.8-27b only produces non-empty chat
# completions (openai/gpt-oss-* currently returns empty). Leave fallback blank
# unless you have verified another model on your key.
GROQ_MODEL=qwen/qwen3.8-27b

# Optional model overrides (all fall back to GROQ_MODEL when unset)
GROQ_FALLBACK_MODEL=
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_TRANSLATE_MODEL=allam-2-7b
GROQ_MODERATION_MODEL=meta-llama/llama-prompt-guard-2-86m

# ── External APIs ───────────────────────────────────────────────────────
USGS_API_BASE=https://earthquake.usgs.gov/fdsnws/event/1
TWITTER_BEARER_TOKEN=your_twitter_bearer_token_here
MAPBOX_ACCESS_TOKEN=your_mapbox_token_here
NOMINATIM_USER_AGENT=AegisAI/1.0

# ── Auth ────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change_this_to_a_long_random_string_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ── Social media polling ────────────────────────────────────────────────
SOCIAL_HASHTAGS=#flood,#earthquake,#cyclone,#fire,#disaster,#SOS,#rescue
SOCIAL_POLL_INTERVAL_SECONDS=60
SOCIAL_PROVIDER=twitter

# ── Speech-to-text ──────────────────────────────────────────────────────
# Provider: groq (cloud, preferred) | local (openai-whisper fallback)
STT_PROVIDER=groq
WHISPER_MODEL=base
WHISPER_MAX_DURATION_SECONDS=30

# ── NLP ─────────────────────────────────────────────────────────────────
NLP_MODEL_PATH=nlp/v1
NLP_MODEL_VERSION=v1_distilbert

# ── Frontend (Vite build-time variables) ────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_URL=http://localhost:8000
VITE_MAPBOX_TOKEN=your_mapbox_token_here

# ── Demo ────────────────────────────────────────────────────────────────
DEMO_SCENARIO=vadodara_flood

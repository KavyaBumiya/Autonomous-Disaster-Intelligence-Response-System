# AegisAI — Environment Configuration Example
# Copy this to .env and fill in your actual values before deployment.

# ── Database ────────────────────────────────────────────────────
POSTGRES_DB=aegisai
POSTGRES_USER=aegisai
POSTGRES_PASSWORD=aegisai_secret
DATABASE_URL=postgresql+asyncpg://aegisai:aegisai_secret@localhost:5432/aegisai

# ── Redis ───────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── External APIs ───────────────────────────────────────────────
USGS_API_BASE=https://earthquake.usgs.gov/fdsnws/event/1
TWITTER_BEARER_TOKEN=your_twitter_bearer_token_here     # Required for social polling
MAPBOX_ACCESS_TOKEN=your_mapbox_access_token_here      # Required for geocoding
NOMINITIM_USER_AGENT=AegisAI/1.0

# ── Auth ────────────────────────────────────────────────────────
# Generate a strong random string for production
JWT_SECRET=change_this_to_a_long_random_string_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ── Social media polling ────────────────────────────────────────
SOCIAL_HASHTAGS=#flood,#earthquake,#cyclone,#fire,#disaster,#SOS,#rescue
SOCIAL_POLL_INTERVAL_SECONDS=60
SOCIAL_PROVIDER=twitter   # "twitter" | "mastodon"

# ── Whisper ─────────────────────────────────────────────────────
WHISPER_MODEL=base        # "tiny", "base", "small", "medium", "large"
WHISPER_MAX_DURATION_SECONDS=30

# ── NLP ─────────────────────────────────────────────────────────
# Path to fine-tuned distilbert weights (relative to /app/models)
NLP_MODEL_PATH=nlp/v1
# "v1_distilbert" or "v0_keyword" (fallback)
NLP_MODEL_VERSION=v1_distilbert

# ── Frontend ────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_URL=http://localhost:8000
VITE_MAPBOX_TOKEN=your_mapbox_access_token_here

# ── Render deployment ───────────────────────────────────────────
# These are typically set as environment variables in the Render dashboard,
# but can also be placed in .env for local development.
RENDER_SERVICE_NAME=aegisai-backend

# ── Demo scenario ───────────────────────────────────────────────
DEMO_SCENARIO=vadodara_flood